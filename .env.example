# ============================================================
# Claude Booking Bot — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# Local run: uvicorn main:app --reload --port 5910
# ============================================================

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Redis ---
# Prefer REDIS_URL on Render; use host/port for local Homebrew Redis.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- PostgreSQL ---
# Prefer DATABASE_URL on Render; use individual vars for local Postgres.
DATABASE_URL=
DB_HOST=localhost
DB_NAME=booking_bot
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# --- Rentok API ---
RENTOK_API_BASE_URL=https://apiv2.rentok.com

# --- OSRM (optional — commute routing) ---
OSRM_API_KEY=

# --- WhatsApp webhook (inbound verify + optional Meta HMAC) ---
WHATSAPP_VERIFY_TOKEN=booking-bot-verify
WHATSAPP_APP_SECRET=

# --- Interakt outbound (stored in brand_config via admin or scripts/setup_whatsapp.py) ---
INTERAKT_ACCESS_TOKEN=
INTERAKT_BASE_URL=https://amped-express.interakt.ai/api/v17.0

# --- Meta Graph outbound (only if is_meta=true in brand config) ---
WHATSAPP_ACCESS_TOKEN=

# --- Payment webhook ---
PAYMENT_WEBHOOK_SECRET=

# --- Admin portal login ---
# If ADMIN_LOGIN_PASSWORD is unset, /admin/login returns 503.
# Local dev: use password 123456 + API key 123456 (seeded in main.py).
ADMIN_LOGIN_USERNAME=oxotel
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_PASSWORD_SHA256=
ADMIN_LOGIN_API_KEY=
DEFAULT_BRAND_API_KEY=OxOtel1234

# --- URLs (brand-config chatbot link, signup emails) ---
CHAT_BASE_URL=https://eazypg-chat.vercel.app
ADMIN_BASE_URL=https://eazypg-admin.vercel.app

# --- Web search (optional) ---
TAVILY_API_KEY=
WEB_SEARCH_MAX_PER_CONVERSATION=3

# --- Semantic KB (requires pgvector on Postgres + Nomic key) ---
NOMIC_API_KEY=
SEMANTIC_KB_ENABLED=false

# --- Feature flags ---
KYC_ENABLED=false
PAYMENT_REQUIRED=false
DYNAMIC_SKILLS_ENABLED=true

# --- OpenRouter (optional — model bake-offs) ---
OPENROUTER_API_KEY=

# --- Model overrides (optional) ---
# HAIKU_MODEL=claude-haiku-4-5-20251001
# SONNET_MODEL=claude-sonnet-4-6
# MAX_AGENT_ITERATIONS=15
# CONVERSATION_HISTORY_LIMIT=20
# CONVERSATION_TTL_SECONDS=86400
